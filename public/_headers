# Netlify headers (Vite copies public/ into dist/). Apache reads .htaccess instead.
#
# Cross-origin isolation is REQUIRED: MuPDF and ONNX Runtime run in workers on
# SharedArrayBuffer, which browsers only expose under these two headers.
#
# COEP is `credentialless` (not `require-corp`) so the Microsoft Clarity tag
# (a cross-origin script from clarity.ms that sends no CORP/CORS header) can
# load while the page stays cross-origin isolated. `credentialless` keeps
# SharedArrayBuffer on Chromium and Firefox; Safari does not support it, so on
# Safari the page is NOT isolated and MuPDF/ONNX may fail to start. If the
# editor must work on Safari more than analytics must load, set this back to
# `require-corp` (Clarity is then blocked).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# The page and the build stamp are checked with the server on every load, so
# a deploy is seen on a plain F5 (src/main.ts also verifies the build).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache, no-store

# The models, fonts and WASM are large and never change under the same name.
/paddle/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/tessdata/*
  Cache-Control: public, max-age=31536000, immutable
/tesseract/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
